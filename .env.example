# Copy to .env (never commit real credentials).
OPSIB_DATABASE_URL=sqlite:///./opsib.db
# OPSIB_DATABASE_URL=postgresql+psycopg://opsib:opsib-local-only@localhost:5432/opsib
OPSIB_EVALUATION_TIME=2026-10-16T15:00:00+05:30
OPSIB_DEFAULT_TENANT_ID=default
OPSIB_SHORTFALL_TOLERANCE_BASE_UNITS=0
OPSIB_AVAILABILITY_MAX_AGE_MINUTES=60
OPSIB_TASK_SLA_HOURS=24
OPSIB_AI_PROVIDER=disabled
OPSIB_LOG_LEVEL=INFO
